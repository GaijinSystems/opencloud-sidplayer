{
  "name": "sidplayer",
  "version": "1.2.0",
  "description": "Play Commodore 64 SID music files directly in OpenCloud Web.",
  "license": "AGPL-3.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build && node scripts/prune-dist.mjs",
    "build:w": "vite build --watch --mode development",
    "dev": "vite",
    "pretest": "node scripts/make-fixtures.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:types": "vue-tsc --noEmit -p tsconfig.json",
    "fixtures": "node scripts/make-fixtures.mjs",
    "preverify:engine": "node scripts/make-fixtures.mjs",
    "verify:engine": "node scripts/verify-engine.mjs",
    "engine": "bash engine/build.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@opencloud-eu/design-system": "^8.0.0",
    "@opencloud-eu/extension-sdk": "^8.0.0",
    "@opencloud-eu/web-client": "^8.0.0",
    "@opencloud-eu/web-pkg": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.1.0"
  }
}
