+    const int v2 = static_cast<int>(muteRamp(1) * voice[1]->output(voice[0]->wave()));
+    const int v3 = static_cast<int>(muteRamp(2) * voice[2]->output(voice[1]->wave()));
 
     const int input = (scaleFactor * static_cast<unsigned int>(filter->clock(v1, v2, v3))) / 2;
 
